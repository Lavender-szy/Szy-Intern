#通用函数
import numpy as np

measurements = np.array([18.5, 21.2, 19.8, 25.4, 17.9])
corrections = np.array([0.5, -0.2, 0.3, -1.4, 0.1])
target = 20
corrected_measurements = measurements + corrections
delta = corrected_measurements - target
abs_delta = np.abs(delta)
delta2 = np.square(delta)
abs_delta05 = np.round(np.sqrt(abs_delta), 2)
max_measurements = np.maximum(corrected_measurements, 18)
min_measurements = np.minimum(corrected_measurements, 24)
print(f"修正后的数据：{corrected_measurements}")
print(f"差值：{delta}")
print(f"绝对误差：{abs_delta}")
print(f"差值平方：{delta2}")
print(f"绝对误差的平方根：{abs_delta05}")
print(f"最低限制后的数据：{max_measurements}")
print(f"最高限制后的数据：{min_measurements}")
