import numpy as np

asset_names = np.array(["ALPHA", "BETA", "GAMMA", "DELTA", "OMEGA"])

returns = np.array([
    [ 0.012,  0.018, -0.006,  0.025,  0.011, -0.009,  0.021,  0.015],
    [-0.015,  0.008,  0.012, -0.011,  0.006,  0.018, -0.007,  0.010],
    [ 0.030, -0.012,  0.022,  0.095, -0.018,  0.027,  0.014, -0.010],
    [ 0.006,  0.009,  0.011,  0.007,  0.013,  0.008,  0.010,  0.012],
    [-0.020, -0.055,  0.017,  0.009, -0.013,  0.021,  0.025,  0.004]
])

market_returns = np.array([
    0.005, 0.004, -0.002, 0.008,
    0.003, 0.006, 0.007, 0.002
])

daily_cost = np.array([
    0.0005,
    0.0004,
    0.0008,
    0.0003,
    0.0006
])
#1
cleaned_returns = np.where(returns > 0.08,0.08,returns)
cleaned_returns = np.where(cleaned_returns < -0.08,-0.08,cleaned_returns)
#2
excess_returns = cleaned_returns - market_returns
#3
net_excess_returns = excess_returns - daily_cost.reshape(-1,1)
#4
mean_return = np.mean(net_excess_returns,axis=1)
positive_day_count = np.sum(net_excess_returns > 0,axis=1)
worst_return = np.min(net_excess_returns,axis = 1)
has_large_loss = np.any(net_excess_returns < -0.05,axis=1)
#5
qualified_mask = (mean_return>0)&(positive_day_count>=5)&(~has_large_loss)
qualified_names = asset_names[qualified_mask]
qualified_mean_returns = mean_return[qualified_mask]
#6
order = np.argsort(qualified_mean_returns)[::-1]
ranked_names = qualified_names[order]
ranked_mean_returns = qualified_mean_returns[order]
#7
top_two_indices = np.argpartition(mean_return,3)[-2:]
top_two_order = np.argsort(mean_return[top_two_indices])[::-1]
top_two_indices = top_two_indices[top_two_order]
top_two_names = asset_names[top_two_indices]
top_two_returns = mean_return[top_two_indices]
